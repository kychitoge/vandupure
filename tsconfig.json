{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "types": ["chrome", "wxt/client"]
  },
  "include": [
    "src/**/*",
    "tests/**/*",
    "wxt.config.ts",
    ".wxt/types/**/*"
  ],
  "exclude": ["node_modules", ".output"]
}
